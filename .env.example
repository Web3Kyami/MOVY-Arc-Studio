# One MOVY deployment serves exactly one Arc network. Production requires all
# three network declarations to agree; never reuse a database between them.
MOVY_TARGET_NETWORK=testnet
NEXT_PUBLIC_MOVY_TARGET_NETWORK=testnet
NEXT_PUBLIC_MOVY_CHAIN_ID=5042002
MOVY_DATABASE_NETWORK=testnet

# Network RPCs. Local development can use the source defaults. Production must
# set matching server and browser URLs for its selected network.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io
ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=

# Public deployment configuration. Mainnet values are unavailable until the
# separately approved deployment exists and config/networks/arc-mainnet.json
# contains its verified evidence.
NEXT_PUBLIC_MOVY_ADDRESS_TESTNET=
NEXT_PUBLIC_MOVY_AUTO_SAVER_TESTNET=
NEXT_PUBLIC_MOVY_DEPLOY_BLOCK_TESTNET=
MOVY_AUTO_SAVER_TESTNET_DEPLOY_BLOCK=
NEXT_PUBLIC_DEMO_STORE_TESTNET=
NEXT_PUBLIC_MOVY_ADDRESS_MAINNET=
NEXT_PUBLIC_MOVY_AUTO_SAVER_MAINNET=
NEXT_PUBLIC_MOVY_DEPLOY_BLOCK_MAINNET=
NEXT_PUBLIC_MOVY_AUTO_SAVER_DEPLOY_BLOCK_MAINNET=
NEXT_PUBLIC_DEMO_STORE_MAINNET=
NEXT_PUBLIC_MOVY_MIN_BASE_FEE_PER_GAS_WEI_MAINNET=
NEXT_PUBLIC_MOVY_MAX_FEE_PER_GAS_WEI_MAINNET=
NEXT_PUBLIC_MOVY_PRIORITY_FEE_PER_GAS_WEI_MAINNET=
NEXT_PUBLIC_MOVY_MAX_TRANSACTION_FEE_WEI_MAINNET=

# WalletConnect Cloud project identifier for mobile and QR wallet connections.
# This is public client configuration, not a wallet key or signing secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Product and Demo are separate origins. Production requires exact origin lists.
MOVY_PRODUCT_ORIGINS=
MOVY_DEMO_ORIGINS=
MOVY_DEMO_ENTRY_ORIGIN=

# Durable PostgreSQL. Configure a separate database/project for every network.
DATABASE_URL=
MOVY_DB_SCHEMA=public
MOVY_DB_POOL_SIZE=2

# Financial services are always disabled by default. Keep false for release
# candidate builds; enabling either needs separate owner approval.
MOVY_WORKER_ENABLED=false
MOVY_RELAYER_ENABLED=false
MOVY_WORKER_AUTH_TOKEN=
CRON_SECRET=
MOVY_WORKER_MAX_BLOCKS=1000
MOVY_OPS_AUTH_TOKEN=

# Server-only relayer signer. Use an approved external secret manager; never
# store a raw key in this file, a deployment artifact, logs, or source control.
# Local Testnet can use an encrypted Foundry keystore and separate mode-0600
# password file; do not put either file inside the repository.
MOVY_RELAYER_KEYSTORE=
MOVY_RELAYER_PASSWORD_FILE=
RELAYER_PRIVATE_KEY=
MOVY_RELAYER_MAX_FEE_PER_GAS_WEI=
MOVY_RELAYER_MAX_TX_FEE_WEI=

# Keep optional checkout integrations off unless separately reviewed.
MOVY_DEMO_MERCHANT_PAYMENT_ENABLED=false
