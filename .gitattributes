# Normalise line endings in the repository, not in the working tree.
# Solidity, TypeScript and Markdown are all authored with LF.
* text=auto eol=lf

*.sol   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.mjs   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf

# Binary assets: never touched. MOVY has none committed, but this keeps a
# future one from being corrupted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary
