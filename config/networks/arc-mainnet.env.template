# MOVY Arc Mainnet (chain 5042) release-candidate configuration TEMPLATE.
#
# Copy these values into a SEPARATE, Mainnet-only deployment project. Never
# merge them with Testnet settings: the Mainnet build guard refuses any set
# Testnet variable. This file holds public values only. No secret belongs here.
#
# This template does not deploy or broadcast. Historical deployments are recorded
# in arc-mainnet.candidate.json; the release AutoSaver must match current source.
# Deployment values match the owner-verified manifest at
# config/networks/arc-mainnet.json. Database credentials stay private.

MOVY_TARGET_NETWORK=mainnet
NEXT_PUBLIC_MOVY_TARGET_NETWORK=mainnet
NEXT_PUBLIC_MOVY_CHAIN_ID=5042
MOVY_DATABASE_NETWORK=mainnet

# Official Arc Mainnet endpoint. Server and browser values must be identical.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Documented Arc explorer. Must equal explorerUrl in the owner-verified manifest.
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io

# Current-source AutoSaver deployment, verified on both Mainnet RPC providers.
# Runtime code matches arc-mainnet.source-lock.json.
NEXT_PUBLIC_MOVY_AUTO_SAVER_MAINNET=0x98ab14da8f6e68add0cdfeb75bdc4c2ea9044539
NEXT_PUBLIC_MOVY_AUTO_SAVER_DEPLOY_BLOCK_MAINNET=29090033

# MOVY Savings Vault (existing deployment)
#   tx 0x135c0543f9f0bb33682c1b7f2a8c204cbbe768db892e4a57fe7f2d9daf40c826
NEXT_PUBLIC_MOVY_ADDRESS_MAINNET=0xFc194011A769e90D93B51Dd9507d69dfc4681164
NEXT_PUBLIC_MOVY_DEPLOY_BLOCK_MAINNET=26036021

# Owner-approved initial pilot fee policy (native USDC, 18-decimal wei).
#   minimum base fee 20 Gwei (Arc documented floor), maximum fee 30 Gwei,
#   priority fee 1 Gwei, maximum transaction fee 0.05 USDC.
# The manifest feePolicy must carry the same values, and the minimum must never
# be below 20 Gwei. The build guard and server startup refuse any mismatch.
NEXT_PUBLIC_MOVY_MIN_BASE_FEE_PER_GAS_WEI_MAINNET=20000000000
NEXT_PUBLIC_MOVY_MAX_FEE_PER_GAS_WEI_MAINNET=30000000000
NEXT_PUBLIC_MOVY_PRIORITY_FEE_PER_GAS_WEI_MAINNET=1000000000
NEXT_PUBLIC_MOVY_MAX_TRANSACTION_FEE_WEI_MAINNET=50000000000000000
MOVY_RELAYER_MAX_FEE_PER_GAS_WEI=30000000000
MOVY_RELAYER_MAX_TX_FEE_WEI=50000000000000000

# Financial actions stay OFF. Enabling either needs separate owner approval.
MOVY_WORKER_ENABLED=false
MOVY_RELAYER_ENABLED=false
MOVY_DEMO_MERCHANT_PAYMENT_ENABLED=false

# Local release candidate only. Use a separate source snapshot without the
# Testnet .env/.env.local files. Supply exact HTTPS origins before hosting.
MOVY_PRODUCT_ORIGINS=http://localhost:3211
MOVY_DEMO_ORIGINS=http://localhost:3212
MOVY_DEMO_ENTRY_ORIGIN=http://localhost:3212
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=5e25341aee85ad77e6b91be549d85000

# Not supplied: set in the separate Mainnet project only.
#   DATABASE_URL (separate Mainnet-only Neon pooled endpoint, TLS required)
#   Final public product origin and isolated Demo boundary
#   NEXT_PUBLIC_DEMO_STORE_MAINNET (only if a reviewed Mainnet demo merchant exists)
